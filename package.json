{
  "name": "mars-life-line",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "pebble:serve": "node --env-file-if-exists=.env.local server/pebble/start.ts",
    "kiln": "node kiln.mjs",
    "kiln:view": "node kiln.mjs view",
    "kiln:status": "node kiln.mjs discover --capabilities --json && node kiln.mjs service status",
    "kiln:check": "cd \"$HOME/Developer/kiln-install\" && npx --offline --no -- kiln-init \"$INIT_CWD\" --check",
    "style:sync": "node scripts/kiln-style-sync.mjs",
    "asset:list-kiln": "node scripts/asset-pipeline.mjs list-kiln",
    "asset:ingest": "node scripts/asset-pipeline.mjs ingest",
    "asset:list": "node scripts/asset-pipeline.mjs list",
    "asset:remove": "node scripts/asset-pipeline.mjs remove",
    "asset:optimize": "node scripts/asset-pipeline.mjs optimize",
    "asset:inspect": "gltf-transform inspect",
    "style:crops": "node scripts/crop-references.mjs",
    "test": "node --test tests/sim/*.test.mjs tests/world/*.test.mjs scripts/check-mars-landscape.mjs scripts/check-asset-colliders.mjs scripts/check-phase2-assets.mjs scripts/check-phase2-support-assets.mjs scripts/check-phase3-assets.mjs",
    "sim:check": "node scripts/sim-check.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/rapier": "^2.2.0",
    "ecctrl": "^2.0.2",
    "leva": "^0.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "meshoptimizer": "^1.3.0",
    "oxlint": "^1.90.0",
    "sharp": "^0.35.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
